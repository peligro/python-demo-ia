ENVIRONMENT=local
PRODUCT_NAME="Python FastAPI - Inteligencia Artificial - Portafolio"
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=fake
AWS_SECRET_ACCESS_KEY=fake
AWS_SECRET_ACCESS_URL=http://localstack:4566
AWS_BUCKET_URL=http://localhost:8000/
S3_BUCKET_NAME="curso-udemy"
DATABASE_URL=postgresql://laravel:secret@postgres:5432/fastapi
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
PORT=8082
COOKIE_DOMAIN=
# ← Producción: descomentar para subdominios
# COOKIE_DOMAIN=.tudominio.com
COOKIE_SECURE=false
#paraproducción  
#COOKIE_SECURE=true
# 24 horas en segundos (mín: 300, máx: 604800)
SESSION_TTL=86400
# Rate limiting (API M3)
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_STRATEGY=fixed-window


BASE_URL_FRONTEND=http://localhost:5173

SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

SQS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/cola-rag

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1/
MISTRAL_MODEL=mistral-small-latest
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com/v1/
CLAUDE_MODEL=claude-opus-4-8
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_MODEL=gpt-4o-mini

 
